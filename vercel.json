{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/ebook-mockup/?",
      "status": 302,
      "headers": {
        "Location": "/events/better-trade/better-trade2026"
      }
    },
    {
      "src": "/events/better-trade/better-trade2026/?",
      "dest": "/mockup/efin-ebook"
    },
    {
      "src": "/events/better-trade/better-trade2026/mock-ebook/(.*)",
      "dest": "/mockup/efin-ebook/$1"
    },
    {
      "src": "/events/api/(gtm|hotjar|posthog)-config",
      "dest": "/mockup/efin-ebook/no-analytics.json"
    },
    {
      "src": "/events/(.*)",
      "dest": "/api/efin-proxy?p=$1"
    },
    {
      "src": "/",
      "status": 302,
      "headers": {
        "Location": "/dna-quiz-flow.html"
      }
    },
    {
      "src": "/quiz",
      "dest": "/dna-quiz-flow.html"
    },
    {
      "src": "/playbook",
      "dest": "/Digital Playbook v8 standalone.html"
    }
  ]
}
